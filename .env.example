# CourseMind environment (placeholders only — never commit real secrets, see CLAUDE.md §3)
# Copy to .env and fill in.

# --- Database (ADR-0001: single Postgres + pgvector) ---
DATABASE_URL=postgresql://coursemind:coursemind@localhost:5432/coursemind

# --- LLM provider (ADR-0002 §1: pluggable, Anthropic default) ---
LLM_PROVIDER=anthropic            # anthropic | openai | google | ollama | openai-compatible
LLM_MODEL=claude-opus-4-8
LLM_API_KEY=
LLM_BASE_URL=                     # for openai-compatible / self-hosted
LLM_FALLBACK_PROVIDER=            # optional secondary (NFR-4)
LLM_FALLBACK_MODEL=

# --- Embeddings (ADR-0002 §2: Google text-embedding-004, 768-dim) ---
EMBEDDING_PROVIDER=google         # google | local | voyage | jina | openai
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768                 # MUST match chunk_embeddings.vector(N); change = migration
GOOGLE_API_KEY=

# --- Chunking (services/ingest-eval; FR-3) ---
CHUNK_SIZE=800                    # max characters per chunk window
CHUNK_OVERLAP=160                 # overlap between adjacent windows

# --- Service wiring ---
INGEST_SERVICE_URL=http://localhost:8000   # TS API -> Python ingest-eval service
PORT=3000                                  # apps/api HTTP listen port
UPLOAD_DIR=/tmp/coursemind-uploads         # apps/api writes uploads here before ingest hand-off
NODE_ENV=development

# --- Retrieval tuning (ADR-0004; M3 Task A) ---
RETRIEVAL_TOP_K=5                          # results per query (vector-search top-K)
RETRIEVAL_SCORE_THRESHOLD=0.35             # max cosine DISTANCE (lower = closer); above best hit = refuse (FR-12)

# --- Web app (apps/web, M3 Task C) — SERVER-ONLY: never prefix with NEXT_PUBLIC_ ---
# The Next.js /api/* routes proxy to apps/api and inject X-User-Id server-side, so the
# browser never sees it. Until student auth lands, set DEMO_USER_ID to the UUID of the
# course OWNER (the API authorises X-User-Id as owner). Leave empty here.
API_URL=http://localhost:3000              # apps/api base URL as seen from the web server
DEMO_USER_ID=                              # course-owner UUID (server-side only)

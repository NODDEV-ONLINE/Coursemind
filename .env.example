# CourseMind environment (placeholders only — never commit real secrets, see CLAUDE.md §3)
# Copy to .env and fill in.

# --- Database (ADR-0001: single Postgres + pgvector) ---
DATABASE_URL=postgresql://coursemind:coursemind@localhost:5432/coursemind

# --- LLM provider (ADR-0002 §1: pluggable, Anthropic default) ---
LLM_PROVIDER=anthropic            # anthropic | openai | google | ollama | openai-compatible
LLM_MODEL=claude-opus-4-8
LLM_API_KEY=
LLM_BASE_URL=                     # for openai-compatible / self-hosted
LLM_FALLBACK_PROVIDER=            # optional secondary (NFR-4)
LLM_FALLBACK_MODEL=

# --- Embeddings (ADR-0002 §2: Google text-embedding-004, 768-dim) ---
EMBEDDING_PROVIDER=google         # google | local | voyage | jina | openai
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768                 # MUST match chunk_embeddings.vector(N); change = migration
GOOGLE_API_KEY=

# --- Service wiring ---
INGEST_SERVICE_URL=http://localhost:8000   # TS API -> Python ingest-eval service
NODE_ENV=development

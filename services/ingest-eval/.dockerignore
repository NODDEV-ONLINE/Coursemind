# .dockerignore for the ingest-eval build context (services/ingest-eval).
# The image installs deps from pyproject.toml; local caches/venv must not leak in.

# Virtualenv & Python caches (image builds its own)
.venv
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
*.egg-info

# Env & secrets — never bake keys into the image (SR-4)
.env
.env.*
!.env.example

# VCS / editor / OS
.git
.idea
.vscode
*.log
.DS_Store
